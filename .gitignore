# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/

# PyInstaller build output
build/
dist/
dist-backup/
*.spec

# Generated icon (regenerated by build.bat via make_icon.py)
# sounddeck.ico is committed intentionally; remove the next line if you prefer to regenerate it
# sounddeck.ico

# Local Claude config
.claude/settings.local.json

# Dev probe / scratch scripts
_*.py
# …but never ignore package __init__.py (the _*.py rule would otherwise eat it)
!**/__init__.py

# Coverage
.coverage
.coverage.*
coverage.xml
htmlcov/

# Logs
*.log
